#!/bin/sh
# vela-ctl: control the Vela daemon from the shell (Sway keybinds, remotes).
#   vela-ctl home | launch <id> | device <id> <command> | volume up|down|mute
#   vela-ctl acceptance hw-check|perf-check|playback-check|tv-check|ir-check [args]
#   vela-ctl setup   (root) open phone setup again
BASE="${VELA_URL:-http://127.0.0.1:7300}"

die() { echo "vela-ctl: $*" >&2; exit 1; }

unreachable() { die "cannot reach the Vela daemon at $BASE. Check that vela-daemon is running."; }

# post <path> [json]; sends JSON ({} by default) so the daemon accepts it.
post() {
  body="$2"
  [ -n "$body" ] || body='{}'
  out=$(curl -sS -X POST -H 'Content-Type: application/json' -d "$body" -w '\n%{http_code}' "$BASE$1" 2>&1)
  rc=$?
  [ $rc -eq 7 ] && unreachable
  [ $rc -ne 0 ] && die "request to $1 failed: $out"
  code=$(printf '%s' "$out" | tail -n 1)
  resp=$(printf '%s' "$out" | sed '$d')
  case "$code" in 2??) ;; *) die "request to $1 failed (HTTP $code): $resp" ;; esac
}

case "$1" in
  home) post /api/home/go ;;
  launch)
    [ -n "$2" ] || die "usage: vela-ctl launch <id>"
    post /api/launch "{\"id\":\"$2\"}" ;;
  device)
    [ -n "$2" ] && [ -n "$3" ] || die "usage: vela-ctl device <id> <command>"
    post "/api/devices/$2/$3" ;;
  volume)
    case "$2" in up|down|mute) ;; *) die "usage: vela-ctl volume up|down|mute" ;; esac
    command -v jq >/dev/null 2>&1 || die "jq is required for the volume command"
    list=$(curl -sS -w '\n%{http_code}' "$BASE/api/devices" 2>&1)
    rc=$?
    [ $rc -eq 7 ] && unreachable
    [ $rc -ne 0 ] && die "could not list devices: $list"
    code=$(printf '%s' "$list" | tail -n 1)
    list=$(printf '%s' "$list" | sed '$d')
    case "$code" in 2??) ;; *) die "could not list devices (HTTP $code): $list" ;; esac
    case "$2" in up) cmd=volume-up ;; down) cmd=volume-down ;; mute) cmd=mute ;; esac
    want=$(printf '%s' "$cmd" | tr - _)
    # The daemon lists the volume device first (volumeDevice in vela.toml, else the first TV);
    # take the first device that has this command (IR code names may use - or _).
    dev=$(printf '%s' "$list" | jq -r --arg c "$want" 'map(select(.commands | map(gsub("-"; "_")) | index($c))) | .[0].id // empty')
    [ -n "$dev" ] || die "no device with $want is configured (see volumeDevice in /etc/vela/vela.toml)"
    post "/api/devices/$dev/$cmd" ;;
  acceptance)
    case "$2" in
      hw-check|perf-check|playback-check|tv-check|ir-check) ;;
      *) die "usage: vela-ctl acceptance hw-check|perf-check|playback-check|tv-check|ir-check [args]" ;;
    esac
    script="${VELA_ACCEPTANCE_DIR:-/usr/libexec/vela/acceptance}/$2.sh"
    [ -x "$script" ] || die "$script is not installed"
    shift 2
    # The scripts talk to the kiosk session, so they run as the vela user (from root over SSH, too).
    if [ "$(id -u)" = 0 ] && [ -z "$VELA_ACCEPTANCE_DIR" ]; then
      vuid=$(id -u vela) || die "there is no vela user on this machine"
      exec runuser -u vela -- env -u WAYLAND_DISPLAY -u SWAYSOCK -u DBUS_SESSION_BUS_ADDRESS \
        HOME=/var/home/vela XDG_RUNTIME_DIR="/run/user/$vuid" "$script" "$@"
    fi
    exec "$script" "$@" ;;
  setup)
    # Opens phone setup, as vela-setup-gate.service does on a box without vela.toml. The gate is
    # root's so a compromised vela session can't reopen setup (and add root SSH keys) itself.
    [ "$(id -u)" = 0 ] || die "setup must run as root (over SSH as root, or with sudo)"
    # Writes the opening time into /run/vela-setup/open and restarts the 2-hour window.
    "${VELA_SETUP_GATE_CMD:-/usr/libexec/vela/setup-gate}" open >/dev/null || die "could not open setup"
    # -M vela@ needs machined's stdio bridge; else vela's own user bus.
    systemctl --user -M vela@ restart vela-daemon.service 2>/dev/null || {
      vuid=$(id -u vela) && runuser -u vela -- env XDG_RUNTIME_DIR="/run/user/$vuid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$vuid/bus" systemctl --user restart vela-daemon.service
    } || die "setup is open, but vela-daemon did not restart; it shows setup within a few seconds anyway"
    echo "Setup is open: the TV now shows a QR code, an address and a PIN."
    echo "Scan the code with your phone (or open the address) and enter the PIN to choose the media server and SSH keys."
    echo "Setup stays open for 2 hours; run vela-ctl setup again for another 2. Restarting the box reopens it too while there is no /etc/vela/vela.toml."
    echo "Finish replaces /etc/vela/vela.toml (the old one is kept as vela.toml.before-setup) and adds the keys to root's authorized_keys." ;;
  *) die "usage: vela-ctl home | launch <id> | device <id> <command> | volume up|down|mute | acceptance <name> | setup" ;;
esac
