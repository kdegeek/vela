#!/bin/bash
# VM smoke test only (vela-smoke-diag.service, runs as root). Reports over the serial console,
# which dev/vm/run-smoke.sh reads:
#   0. phone setup: the image has no vela.toml, so the box boots into setup. Wait for the setup
#      screen and print its PIN -> "VELA-SMOKE SETUP-PIN <pin>" (again whenever it changes); the
#      runner takes vm-setup-3840.png and drives the setup API from the host (port 7301: skip
#      media, add its throwaway SSH key, finish). Wait for root's vela-setup-commit, check what it
#      installed, then append the test-only [server] settings and restart the daemon
#      -> "VELA-SMOKE PHASE0" (the runner then checks SSH with its key and the API on port 7300)
#   1. wait for the kiosk Chromium window on workspace "home", record state  -> "VELA-SMOKE PHASE1"
#   2. give the runner time for its screenshot, then crash sway (SIGSEGV)
#   3. wait for greetd's new sway and the kiosk to come back, record state  -> "VELA-SMOKE PHASE2"
#   3b. break /etc/vela/vela.toml, restart vela-daemon: it must still serve the launcher and say
#       which file to fix (degraded mode), then restore the file and check it recovers
#   4. print the whole report between "VELA-SMOKE DIAG BEGIN/END", then "VELA-SMOKE DONE"
# Each assertion is a "CHECK <name> PASS|FAIL" line; the runner fails the job on any FAIL.
set -u
out=/var/lib/vela/smoke
mkdir -p "$out"
report="$out/diag.txt"
: > "$report"
serial=/dev/ttyS0

say() { printf '%s\n' "$*" > "$serial" 2>/dev/null || true; printf '%s\n' "$*" >> "$report"; }
log() { printf '%s\n' "$*" >> "$report"; }
check() { # check <name> <command...>
  local name=$1; shift
  if "$@" >/dev/null 2>&1; then say "CHECK $name PASS"; else say "CHECK $name FAIL"; fi
}

uid=$(id -u vela)
rt=/run/user/$uid
swaysock() { ls -t "$rt"/sway-ipc.*.sock 2>/dev/null | head -n1; }
sm() { SWAYSOCK=$(swaysock) swaymsg "$@"; }
sway_pid() { pgrep -u vela -x sway | head -n1; }
sway_running() { [ -n "$(sway_pid)" ]; }
userctl() { # systemctl --user for vela, with a fallback that doesn't need machined
  systemctl --user -M vela@ "$@" 2>/dev/null \
    || setpriv --reuid="$uid" --regid="$(id -g vela)" --init-groups \
         env XDG_RUNTIME_DIR="$rt" DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus" systemctl --user "$@"
}
asvela() { # run a command as vela with the user bus
  setpriv --reuid="$uid" --regid="$(id -g vela)" --init-groups \
    env XDG_RUNTIME_DIR="$rt" DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus" "$@"
}
graphical_session() { userctl is-active --quiet graphical-session.target; }
# A portal round trip: D-Bus activates xdg-desktop-portal, which needs graphical-session.target.
portal_call() {
  asvela busctl --user --timeout=30 call org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
    org.freedesktop.DBus.Properties Get ss org.freedesktop.portal.Settings version
}
userjournal() {
  journalctl -b --no-pager _UID="$uid" -n 120 2>/dev/null
}
# The sway assign rule in /usr/share/vela/sway/config, applied to workspace "home".
kiosk_on_home() {
  sm -t get_tree | jq -e '
    [recurse(.nodes[]?, .floating_nodes[]?) | select(.type == "workspace" and .name == "home")
     | recurse(.nodes[]?, .floating_nodes[]?)
     | select((.app_id // "") | test("^(chrome-127\\.0\\.0\\.1|chromium)"))] | length > 0'
}
units_active() { userctl is-active --quiet vela-daemon.service vela-kiosk.service; }
daemon_pid() { userctl show -p MainPID --value vela-daemon.service; }
# session-start ran in the new sway and restarted the daemon (it then uses the new SWAYSOCK).
daemon_restarted() { p=$(daemon_pid); [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != "$old_daemon" ]; }
# sway and the kiosk run in the user's domain, not greetd's xdm_t.
not_xdm_t() { ! ps -u vela -o label=,comm= | grep -E 'sway|chrom' | grep -q ':xdm_t:'; }

capture() {
  log ""
  log "################ $1 ($(date -Is), uptime $(cut -d' ' -f1 /proc/uptime) s)"
  {
    echo "--- swaymsg -t get_outputs"; sm -t get_outputs -r | jq -c '.[] | {name, current_mode, scale}'
    echo "--- swaymsg -t get_workspaces"; sm -t get_workspaces -r | jq -c '.[] | {name, focused, output}'
    echo "--- windows (from get_tree)"
    sm -t get_tree -r | jq -c '
      recurse(.nodes[]?, .floating_nodes[]?) | select(.type == "workspace") as $ws
      | $ws | recurse(.nodes[]?, .floating_nodes[]?) | select(.pid? != null)
      | {workspace: $ws.name, app_id, class: .window_properties.class, name, pid, fullscreen_mode, focused, rect}'
    echo "--- swaymsg -t get_tree (full)"; sm -t get_tree -r
    echo "--- systemctl --user status"
    userctl status --no-pager --lines=15 vela-session.target vela-daemon.service vela-kiosk.service
    echo "--- systemctl --user --failed"; userctl --failed --no-pager
    echo "--- graphical-session.target / portal"
    userctl is-active graphical-session.target xdg-desktop-portal.service xdg-desktop-portal-wlr.service xdg-desktop-portal-gtk.service
    portal_call
    echo "--- user manager environment (XDG_*)"; userctl show-environment | grep -E '^(XDG_|WAYLAND_|SWAYSOCK)'
    echo "--- loginctl"; loginctl list-sessions --no-pager
    for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
      loginctl show-session "$s" -p Id -p Name -p Type -p Class -p State -p Seat -p VTNr -p Service -p Remote
    done
    echo "--- ps -e -o label (sway, chromium, node, greetd)"
    ps -e -o label,pid,ppid,user,comm | grep -E 'LABEL|sway|chrom|node|greetd'
    echo "--- SELinux"; getenforce
    echo "--- sshd / firewalld (docs/install.md relies on SSH for later config edits)"
    rpm -q openssh-server firewalld; systemctl is-enabled sshd.service firewalld.service; systemctl is-active sshd.service
    echo "--- bootc status"; bootc status 2>&1 | head -n 30
    echo "--- kernel command line"; cat /proc/cmdline
    echo "--- AVC denials this boot (audit transport)"
    journalctl -b --no-pager _TRANSPORT=audit -g 'avc:' 2>/dev/null | tail -n 60
    echo "--- AVC denials this boot (all journal)"
    journalctl -b --no-pager -g 'avc: +denied' 2>/dev/null | tail -n 60
    if command -v ausearch >/dev/null; then echo "--- ausearch -m avc -ts boot"; ausearch -m avc -ts boot 2>&1 | tail -n 60; fi
    echo "--- vela user journal (tail)"; userjournal
    echo "--- greetd journal (tail)"; journalctl -b --no-pager -u greetd -n 40
  } >> "$report" 2>&1
}

wait_for() { # wait_for <seconds> <command...>
  local deadline=$(( $(date +%s) + $1 )); shift
  while [ "$(date +%s)" -lt "$deadline" ]; do "$@" >/dev/null 2>&1 && return 0; sleep 2; done
  return 1
}

say "VELA-SMOKE START uptime=$(cut -d' ' -f1 /proc/uptime)"

# --- 0. phone setup --------------------------------------------------------------------------------
# The PIN is in /api/home only while the main API listens on loopback, which it does until the
# [server] settings below are appended. This serial console is test-only, so printing it is fine.
gate=/run/vela-setup/open
cfg=/etc/vela/vela.toml
api_home() { curl -fsS -m 5 http://127.0.0.1:7300/api/home; }
setup_pin() { api_home | jq -r '.setup.pin // empty' 2>/dev/null | grep -xE '[0-9]{6}'; }
# The setup screen with a QR code: an address (null = "Connect Ethernet") and a PIN.
setup_ready() { kiosk_on_home && api_home | jq -e '.setup.url != null and (.setup.pin | type) == "string"'; }
setup_expire_armed() { [ -e "$gate" ] && systemctl is-active --quiet vela-setup-expire.timer; }
commit_journal() { journalctl -b --no-pager -o cat -u vela-setup-commit.service 2>/dev/null; }
# setup-commit removes the gate before it restarts the daemon, so "done" is its last line.
commit_done() { commit_journal | grep -qE 'vela-setup-commit: (restarted vela-daemon|could not restart|REFUSED)'; }
setup_committed() {
  commit_journal | grep -q 'vela-setup-commit: restarted vela-daemon' && ! commit_journal | grep -q 'REFUSED'
}
mode_of() { stat -c '%U:%G %a' "$1" 2>/dev/null; }
# The runner's key has the comment "vela-smoke-runner" (run-smoke.sh).
setup_files_installed() {
  [ "$(mode_of "$cfg")" = "root:root 644" ] \
    && [ "$(mode_of /var/roothome/.ssh)" = "root:root 700" ] \
    && [ "$(mode_of /var/roothome/.ssh/authorized_keys)" = "root:root 600" ] \
    && grep -q ' vela-smoke-runner$' /var/roothome/.ssh/authorized_keys
}
setup_gate_closed() { [ ! -e "$gate" ] && ! systemctl is-active --quiet vela-setup-expire.timer; }
# ss must work and list nothing: a missing ss is a failure, not a pass.
setup_port_closed() { local l; l=$(ss -Hltn 'sport = :7301') && [ -z "$l" ]; }
setup_avcs() {
  { journalctl -b --no-pager -g 'avc: +denied' 2>/dev/null
    if command -v ausearch >/dev/null; then ausearch -m avc -ts boot 2>/dev/null | grep 'avc: *denied'; fi
  } | grep -E 'setup-commit|setup-gate|runuser'
}
setup_no_avc() { ! setup_avcs; }
home_after_setup() { api_home | jq -e '.setup == null and (.apps | length) == 6'; }

if wait_for 600 setup_ready; then
  sleep 30  # let the setup screen paint before the runner's screenshot
else
  say "VELA-SMOKE setup screen not ready after 10 minutes"
fi
{ echo "--- setup (before the runner): /api/home .setup, gate, timer"
  api_home | jq -c '.setup | del(.pin)'; ls -l "$gate"; cat "$gate"
  systemctl show -p ActiveState -p NextElapseUSecMonotonic -p NextElapseUSecRealtime vela-setup-expire.timer
  systemctl status --no-pager --lines=5 vela-setup-gate.service; } >> "$report" 2>&1
check setup_expire_armed setup_expire_armed
pin=$(setup_pin)
say "VELA-SMOKE SETUP-PIN ${pin:-none}"
# A new PIN (five wrong tries, or a daemon restart) is printed again for the runner.
( last=$pin
  while [ -e "$gate" ]; do
    p=$(setup_pin)
    if [ -n "$p" ] && [ "$p" != "$last" ]; then say "VELA-SMOKE SETUP-PIN $p"; last=$p; fi
    sleep 2
  done ) &
pin_watch=$!
wait_for 300 commit_done
kill "$pin_watch" 2>/dev/null
wait_for 30 setup_gate_closed
wait_for 30 setup_port_closed
{ echo "--- vela-setup-commit journal"; commit_journal
  echo "--- installed files"
  ls -lZd "$cfg" /var/roothome/.ssh /var/roothome/.ssh/authorized_keys; cat "$cfg"
  echo "--- after setup: gate, timer, port 7301"
  ls -la /run/vela-setup; systemctl is-active vela-setup-expire.timer; ss -Hltn 'sport = :7301'
  echo "--- AVC denials mentioning setup"; setup_avcs; } >> "$report" 2>&1
commit_journal | tail -n 12 | while IFS= read -r line; do say "VELA-SMOKE commit: $line"; done
check setup_committed setup_committed
check setup_files_installed setup_files_installed
check setup_gate_closed setup_gate_closed
check setup_port_closed setup_port_closed
check setup_no_avc setup_no_avc
# Test-only settings setup can't produce: append [server] listen = 0.0.0.0 (appended in place, so
# the file keeps the label and mode setup-commit gave it) and restart the daemon. If setup never
# wrote vela.toml, its checks failed above; write a mock config and close setup so the rest of the
# run still produces a report.
if [ ! -s "$cfg" ]; then
  say "VELA-SMOKE no vela.toml after setup; writing the test config so the later phases run"
  printf '[media]\nprovider = "mock"\n' > "$cfg"
  rm -f "$gate"
fi
{ echo; cat /usr/share/vela-smoke/vela-server.toml; } >> "$cfg"
userctl restart vela-daemon.service
wait_for 120 home_after_setup
{ echo "--- /api/home after setup"; api_home | jq -c '{setup, status, apps: (.apps | length)}'; } >> "$report" 2>&1
say "VELA-SMOKE PHASE0"

# --- 1. first boot -------------------------------------------------------------------------------
wait_for 600 kiosk_on_home
say "VELA-SMOKE kiosk-window uptime=$(cut -d' ' -f1 /proc/uptime)"
sleep 30  # let the launcher page load and paint before the screenshot
capture "PHASE 1: first boot"
check kiosk_on_home_first_boot kiosk_on_home
check units_active_first_boot units_active
check sway_running_first_boot sway_running
check session_domain_first_boot not_xdm_t
check graphical_session_first_boot graphical_session
check portal_first_boot portal_call
old_pid=$(sway_pid)
old_daemon=$(daemon_pid)
say "VELA-SMOKE PHASE1 sway_pid=${old_pid:-none}"
sleep 75  # the runner takes vm-home-3840.png now

# --- 2. crash sway; greetd starts a new one, session-start restarts the daemon and the kiosk ---
say "VELA-SMOKE crashing sway (SIGSEGV) pid=${old_pid:-none}"
[ -n "$old_pid" ] && kill -SEGV "$old_pid"
new_sway() { p=$(sway_pid); [ -n "$p" ] && [ "$p" != "$old_pid" ]; }
wait_for 180 new_sway
wait_for 180 kiosk_on_home
sleep 30
capture "PHASE 2: after the sway crash"
check sway_restarted new_sway
check kiosk_on_home_after_crash kiosk_on_home
check units_active_after_crash units_active
check daemon_restarted_after_crash daemon_restarted
check session_domain_after_crash not_xdm_t
check graphical_session_after_crash graphical_session
check portal_after_crash portal_call
say "VELA-SMOKE PHASE2 sway_pid=$(sway_pid)"
sleep 45  # the runner takes vm-after-crash.png now

# --- 2b. the owner-run hardware check, as the vela user inside the session -----------------------------
# Most of its checks fail in a VM (no T2, no Flirc, no VA-API); this only proves it runs end to end
# and leaves a report bundle.
accept_dir=/var/home/vela
run_hw_check() {
  rm -f "$accept_dir"/vela-report-*.tar.gz
  # The documented way: root runs vela-ctl, which hands over to vela. A clean environment like an
  # SSH login, so no session variables are exported here.
  { echo "################ hw-check"; timeout 200 env -i PATH=/usr/sbin:/usr/bin HOME=/root \
      /usr/bin/vela-ctl acceptance hw-check; echo "hw-check exit status $?"; } > "$out/hw-check.txt" 2>&1
  tail -n 1 "$out/hw-check.txt" | grep -q 'exit status [01]$'
}
hw_kiosk_check() { grep -q '^PASS kiosk window on workspace home' "$out/hw-check.txt"; }
hw_bundle() { tar tzf "$accept_dir"/vela-report-*.tar.gz | grep -q 'hw-check.txt'; }
check acceptance_hw_check_runs run_hw_check
check acceptance_hw_check_bundle hw_bundle
check acceptance_hw_check_kiosk_window hw_kiosk_check
{ echo "################ hw-check output"; cat "$out/hw-check.txt"; } >> "$report"

# --- 2b'. automatic updates stage only, at night (bootc-fetch-apply-updates drop-ins) -----------------
updates_stage_only() {
  local exec cal
  exec=$(systemctl show -p ExecStart --value bootc-fetch-apply-updates.service)
  cal=$(systemctl show -p TimersCalendar --value bootc-fetch-apply-updates.timer)
  echo "ExecStart: $exec"; echo "TimersCalendar: $cal"
  systemctl is-enabled --quiet bootc-fetch-apply-updates.timer \
    && [[ "$exec" == *"argv[]=/usr/bin/bootc upgrade --quiet ;"* ]] && [[ "$exec" != *--apply* ]] && [[ "$cal" == *03:00* ]]
}
{ echo "--- bootc updates"; updates_stage_only; } >> "$report" 2>&1
check updates_stage_only_at_night updates_stage_only

# --- 2b''. Apple's Wi-Fi firmware is downloaded on first boot (vela-wifi-firmware.service) ------------
# The VM has no Broadcom card, but the download, checksum and unpack are the same as on the Mac.
fw=/var/lib/vela/firmware
wifi_firmware() {
  [ -e "$fw/.fetched" ] && compgen -G "$fw/brcm/brcmfmac4364b2-pcie.apple,*.bin" >/dev/null \
    && ! systemctl is-failed --quiet vela-wifi-firmware.service
}
wait_for 300 wifi_firmware
{ echo "--- vela-wifi-firmware"; systemctl status --no-pager --lines=20 vela-wifi-firmware.service
  ls -la "$fw" "$fw/brcm" | head -n 12; echo "files: $(find "$fw/brcm" -type f 2>/dev/null | wc -l)"; } >> "$report" 2>&1
check wifi_firmware_downloaded wifi_firmware

# --- 2c. degraded mode: a typo in vela.toml must not take the home screen down ----------------------
# The broken file falls back to listen = 127.0.0.1, so this is checked from inside the VM only, after
# the runner's host-side probes. The file is rewritten in place (not moved) to keep its SELinux label.
cp -a "$cfg" "$out/vela.toml.orig"
printf '[ui]\neffects = "banana"\n' > "$cfg"
userctl restart vela-daemon.service
degraded_line() { api_home | jq -e '.status.line | test("vela\\.toml")'; }
degraded_apps() { api_home | jq -e '(.apps | length) == 6'; }
launcher_page() { curl -fsS -m 5 http://127.0.0.1:7300/ | grep -qi '<!doctype html'; }
wait_for 90 degraded_line
{ echo "--- degraded /api/home status"; api_home | jq -c .status; } >> "$report" 2>&1
check degraded_status_line_names_vela_toml degraded_line
check degraded_home_lists_apps degraded_apps
check degraded_serves_launcher launcher_page
cat "$out/vela.toml.orig" > "$cfg"
userctl restart vela-daemon.service
recovered() { api_home | jq -e '.status.line == null and (.apps | length) == 6'; }
wait_for 90 recovered
check restored_config_recovers recovered

# --- 3. the report ---------------------------------------------------------------------------------
{
  echo "VELA-SMOKE DIAG BEGIN"
  cat "$report"
  echo "VELA-SMOKE DIAG END"
  echo "VELA-SMOKE DONE"
} > "$serial" 2>/dev/null
