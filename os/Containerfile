# Vela OS: a Fedora bootc image for the 2018 Mac mini (Intel UHD 630, Apple T2).
# Build context is the repository root:
#   buildah build -f os/Containerfile --platform linux/amd64 -t vela .

# t2linux kernel from the sharpenedblade/t2linux COPR (https://wiki.t2linux.org/distributions/fedora/installation/).
# Pinned on purpose. The COPR prunes old builds, so image.yml mirrors these RPMs to the GitHub
# release t2-kernel-<version>; the build uses the COPR first and falls back to that release.
# kernel-pin.yml fails weekly while the COPR has a newer kernel: bump this deliberately.
ARG T2_KERNEL=7.2.9-310.t2.fc44
ARG T2_KERNEL_MIRROR=https://github.com/kdegeek/vela/releases/download
# auto (COPR, then mirror) or mirror (mirror only).
ARG T2_KERNEL_SOURCE=auto
# Flipper-IRDB (CC0-1.0), pinned.
ARG IRDB_COMMIT=d126fb1b6f1e114c52b4a8c19839ea65e3a9c24d

# Build scripts, bind-mounted into RUN steps so they never land in the image.
FROM scratch AS ctx
COPY os/build /

# --- pnpm workspace: daemon + launcher ---------------------------------------
FROM docker.io/library/node:22 AS app
WORKDIR /src
RUN npm install -g pnpm@12.8.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/daemon/package.json apps/daemon/
COPY apps/launcher/package.json apps/launcher/
RUN pnpm install --frozen-lockfile
COPY packages packages
COPY apps apps
RUN pnpm -r build \
 && pnpm --filter @vela/daemon deploy --prod /out/daemon \
 && rm -rf /out/daemon/src /out/daemon/test /out/daemon/assets /out/daemon/manifests \
    /out/daemon/vitest.config.ts /out/daemon/tsconfig.json /out/daemon/tsconfig.tsbuildinfo
# Smoke check: the deployed tree starts and answers on its own (no workspace around it).
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/smoke-daemon.sh node /out/daemon /src/apps/daemon/assets /src/apps/daemon/manifests /src/apps/launcher/dist

# --- Flipper-IRDB at a pinned commit -----------------------------------------
FROM docker.io/library/node:22 AS irdb
ARG IRDB_COMMIT
RUN git init -q /irdb \
 && git -C /irdb fetch -q --depth 1 https://github.com/Lucaslhm/Flipper-IRDB.git "$IRDB_COMMIT" \
 && git -C /irdb checkout -q FETCH_HEAD \
 && test "$(git -C /irdb rev-parse HEAD)" = "$IRDB_COMMIT" \
 && rm -rf /irdb/.git /irdb/.github

# --- OS image -----------------------------------------------------------------
FROM quay.io/fedora/fedora-bootc:44
ARG T2_KERNEL
ARG T2_KERNEL_MIRROR
ARG T2_KERNEL_SOURCE
LABEL org.vela.kernel="${T2_KERNEL}"

# 1-2. t2linux kernel and T2 support packages (initramfs is rebuilt at the end, after Plymouth).
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/var \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/t2-kernel.sh "$T2_KERNEL" "$T2_KERNEL_MIRROR" "$T2_KERNEL_SOURCE"

# 3-4. RPM Fusion codecs and VA-API, then the session packages.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/var \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/packages.sh

# 5. Daemon, launcher, manifests, assets, vela-ctl.
COPY --from=app /out/daemon /usr/lib/vela/daemon
COPY --from=app /src/apps/launcher/dist /usr/lib/vela/launcher
COPY --from=app /src/apps/daemon/manifests /usr/share/vela/apps
COPY --from=app /src/apps/daemon/assets /usr/share/vela/assets
COPY --chmod=0755 bin/vela-ctl /usr/bin/vela-ctl

# 6. System files and the IR database.
COPY --from=irdb /irdb /usr/share/vela/irdb
COPY os/files/ /

# 7. Services, Plymouth, initramfs, and checks; finish with bootc's own lint.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=tmpfs,dst=/var \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/finalize.sh

RUN bootc container lint
