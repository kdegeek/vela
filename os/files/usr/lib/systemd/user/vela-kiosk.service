[Unit]
Description=Vela launcher (kiosk Chromium)
PartOf=vela-session.target
# Restart=always forever: hitting the start limit would leave a dead screen until a reboot.
StartLimitIntervalSec=0
After=vela-session.target vela-daemon.service

[Service]
Type=exec
ExecStart=/usr/libexec/vela/launcher-kiosk
Restart=always
RestartSec=1

[Install]
WantedBy=vela-session.target
