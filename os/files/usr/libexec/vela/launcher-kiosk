#!/bin/sh
# Runs the launcher in a kiosk Chromium (vela-kiosk.service). WAYLAND_DISPLAY and SWAYSOCK come
# from session-start's import into the user manager.
#
# First start in a sway session: wait until the daemon answers (at most ~30 s; the launcher page
# retries on its own after that) and show workspace "home". A restart after a crash does neither:
# the window lands on "home" by the sway assign rule, and whatever app is on screen stays there.
marker="${XDG_RUNTIME_DIR:-/tmp}/vela-kiosk.started"
if [ "$(cat "$marker" 2>/dev/null)" != "$SWAYSOCK" ]; then
  deadline=$(($(date +%s) + 30))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    curl -fs -o /dev/null -m 2 -H 'Host: 127.0.0.1:7300' http://127.0.0.1:7300/api/health && break
    sleep 0.5
  done
  swaymsg workspace home >/dev/null
  printf '%s\n' "$SWAYSOCK" > "$marker"
fi

browser=$(command -v chromium-browser || command -v chromium)
# VELA_KIOSK_FLAGS: extra Chromium flags from a unit drop-in (the VM test image sets --disable-gpu).
# shellcheck disable=SC2086 # word splitting is intended
exec "$browser" ${VELA_KIOSK_FLAGS:-} --ozone-platform=wayland --kiosk --app=http://127.0.0.1:7300 \
  --force-device-scale-factor=1 --enable-gpu-rasterization --noerrdialogs --disable-session-crashed-bubble
