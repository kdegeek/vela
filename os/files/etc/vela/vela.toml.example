# /etc/vela/vela.toml -- every field is optional; values shown are the defaults unless noted.

[server]
# Address the daemon binds (port is always 7300). The VM smoke test sets "0.0.0.0".
listen = "127.0.0.1"

[ui]
# "auto" picks by GPU, "full" forces blur/glow effects, "lite" disables them.
effects = "auto"
# 24-hour clock in the status line.
clock24h = false

[media]
# "mock" shows built-in sample content; "jellyfin" reads your server.
provider = "mock"

# [media.jellyfin]
# url = "http://jellyfin.lan:8096"
# username = "nate"   # the token is stored in /var/lib/vela/secrets.json, not here
#
# Secrets (Jellyfin and Home Assistant tokens) live only in /var/lib/vela/secrets.json, which
# must be owned by vela with mode 0600 (chown vela:vela, chmod 0600). A tmpfiles rule restores
# that owner and mode at every boot if the file exists.

# [homeAssistant]
# url = "http://127.0.0.1:8123"   # Home Assistant runs on the box itself
# insideTempEntity = "sensor.living_room_temperature"

# [ir]
# The headphone-jack IR blaster plays on this PipeWire sink. Unset, Vela picks the sink whose name
# says headphone or analog (never HDMI); `wpctl status` and `pw-dump` list the node names.
# audioJackSink = "alsa_output.pci-0000_00_1f.3.analog-stereo"

# Directories scanned for app manifests; later entries override earlier ones by id.
# manifestDirs = ["/usr/share/vela/apps", "/etc/vela/apps"]

# A TV controlled through Home Assistant.
# [[devices]]
# id = "tv"
# name = "Living room TV"
# kind = "tv"
# entity = "media_player.living_room_tv"
# powerOnFallback = { file = "samsung/tv.ir", button = "KEY_POWER" }   # relative to /usr/share/vela/irdb

# An IR-controlled device.
# [[devices]]
# id = "soundbar"
# name = "Soundbar"
# kind = "ir"
# transmitter = "irctl"            # or "audiojack"
# [devices.codes]
# power = { file = "sony/soundbar.ir", button = "KEY_POWER" }
# volup = { file = "sony/soundbar.ir", button = "KEY_VOLUMEUP" }
